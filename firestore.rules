rules_version = '2';
// Die App greift nie direkt auf die Datenbank zu. Guthaben und Käufe ändert nur der Server
// (Admin SDK umgeht diese Regeln). So kann niemand sein Guthaben selbst hochsetzen.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
